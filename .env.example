# ==========================================================================
# Vellum 配置。复制成 .env 再改。
#   cp .env.example .env
# 只有 SESSION_SECRET、SITE_DOMAIN 和 VELLUM_PORT 是真正需要你填的。
# ==========================================================================

# --------------------------------------------------------------------------
# 必填
# --------------------------------------------------------------------------

# 会话密钥。决定登录 cookie 的签名。
# 生成方法：  openssl rand -hex 32
# 不填的话每次重启都会随机生成，所有人都会被登出。
SESSION_SECRET=

# 你的域名（只给 Caddy 用，用来申请 HTTPS 证书）。
# 必须已经解析到这台服务器的公网 IP，否则证书签发会失败。
# 例： chat.example.com
SITE_DOMAIN=

# --------------------------------------------------------------------------
# 站点外观（都可选）
# --------------------------------------------------------------------------

# 站点名，显示在浏览器标题、登录页、导航栏
SITE_NAME=Vellum

# 登录页主标题下面的一句话
SITE_TAGLINE=没有信息流，没有推荐，没有陌生人。

# --------------------------------------------------------------------------
# 注册
# --------------------------------------------------------------------------

# 是否允许注册。false 之后只有已存在的账号能登录。
ALLOW_REGISTER=true

# 邀请码。留空 = 自动生成一个并保存在数据库里。
# 第一次启动时会把邀请码打印在日志里，管理员也能在「设置」里查看和更换。
# 如果你想让邀请码写死在配置里（界面上就不可更换），在这里填一个。
INVITE_CODE=

# 限制只能用某些邮箱域名注册，逗号分隔。留空表示不限制。
# 例： qq.com,163.com
ALLOWED_EMAIL_DOMAINS=

# --------------------------------------------------------------------------
# 存储与上传
# --------------------------------------------------------------------------

# 数据目录（数据库 + 上传的文件都在这里）。容器里固定是 /app/data
DATA_DIR=data

# 单个文件上限，单位 MB。分块上传，所以可以开得很大。
MAX_FILE_MB=4096

# 每个分块的大小，单位 MB。网络差就调小（比如 2），内网就调大（比如 16）。
# 注意：调大之后 Nginx 的 client_max_body_size 也要跟着调。
CHUNK_MB=4

# 每人每天的上传总额度，单位 MB。0 = 不限。
# 朋友共用一台机器时建议设一个，比如 20480（20 GB）。
DAILY_UPLOAD_MB=0

# 磁盘剩余低于这个值就拒绝新上传，单位 MB。
MIN_FREE_MB=512

# --------------------------------------------------------------------------
# 行为
# --------------------------------------------------------------------------

# 消息可撤回的时间窗口，单位秒。0 = 永久可撤回。
RECALL_SECONDS=120

# 语音消息最长录制时长，单位秒
MAX_VOICE_SECONDS=300

# 登录状态保持多少天
SESSION_DAYS=30

# 反向代理后面要信任的跳数（也就是要不要相信 X-Forwarded-For）。
#
# 在 Caddy / nginx 后面就保持 1，这样限流和访问日志拿到的是真实客户端 IP。
# docker compose 的 compose 文件里已经写死 1，这个值对那条路径没有影响。
#
# 如果应用是**直接暴露**出去的（没有反代），必须改成 0：
# 否则客户端可以自己写 X-Forwarded-For，把登录限流用的 IP 换成任意值，
# 每换一个就是一个新的限流桶，密码爆破等于没有限制。
TRUST_PROXY=1

# 强制 cookie 带 Secure 标记。
#
# 不要写成 `COOKIE_SECURE=`（空值）—— 空值会被当成 false，等于显式关掉
# Secure，HTTPS 站点上会话 cookie 也会明文发出去。真正的「自动判断」是
# 把这一行整条注释掉（保持未定义），此时按请求协议决定；
# 只有在「HTTPS 由外层设备终止、应用自己看到的永远是 http」时才写 true。
# COOKIE_SECURE=true

# --------------------------------------------------------------------------
# 端口与监听
# --------------------------------------------------------------------------

# 容器内监听端口。想让外面用别的端口访问，改 VELLUM_PORT 而不是这个。
PORT=8787
HOST=0.0.0.0

# 宿主机映射端口，只给 docker-compose 用。
# 默认只映射到 127.0.0.1，也就是只能通过同机的反向代理访问，不直接暴露到公网。
VELLUM_PORT=8787
